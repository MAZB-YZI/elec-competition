/**
 * test_encoder.c — 编码器中断测试
 *
 * 单独验证编码器硬件和中断是否正常工作
 * 烧录后转动手轮，看 OLED 计数是否变化
 *
 * 编码器引脚：
 *   Motor1 A=PA25, B=PA14
 *   Motor2 A=PA26, B=PA27
 */

#include "ti_msp_dl_config.h"
#include "encoder.h"
#include "oled.h"
#include "delay.h"

/* GROUP1_IRQHandler 在 hcar_hal.c 中定义 */

int main(void)
{
    SYSCFG_DL_init();
    Encoder_Init();
    OLED_Init();

    /* 编码器中断由 hcar_hal.c 的 HCarHal_Init 配置 */
    /* 手动再开一次确保开启 */
    DL_GPIO_clearInterruptStatus(GPIOA, ENCODER1_A_ENC1_A_PIN | ENCODER2_A_ENC2_A_PIN);
    DL_GPIO_enableInterrupt(GPIOA, ENCODER1_A_ENC1_A_PIN);
    DL_GPIO_enableInterrupt(GPIOA, ENCODER2_A_ENC2_A_PIN);
    NVIC_EnableIRQ(GPIOA_INT_IRQn);

    OLED_Clear();
    OLED_ShowString(0, 0, "ENCODER TEST", 12);
    OLED_ShowString(0, 16, "Turn wheels...", 12);
    OLED_Refresh();

    while (1) {
        EncoderCounts cnt = Encoder_GetCount();

        OLED_Clear();
        OLED_ShowString(0, 0, "ENCODER TEST", 12);

        OLED_ShowString(0, 16, "L:", 12);
        OLED_ShowNum(16, 16, (uint32_t)(cnt.left > 0 ? cnt.left : -cnt.left), 6, 12);

        OLED_ShowString(0, 32, "R:", 12);
        OLED_ShowNum(16, 32, (uint32_t)(cnt.right > 0 ? cnt.right : -cnt.right), 6, 12);

        OLED_Refresh();
        delay_ms(100U);
    }
}
